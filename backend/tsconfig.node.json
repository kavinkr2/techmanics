{
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.bin/tsc",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["vite.config.ts"]
}
